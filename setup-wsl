#!/usr/bin/env bash
# Laravel + WSL 2 setup for Ubuntu 22.04/24.04.
# Run inside Ubuntu WSL as a normal user: chmod +x setup-laravel-wsl.sh && ./setup-laravel-wsl.sh
# Windows WSL feature installation must be done separately in elevated PowerShell:
#   wsl --install
set -Eeuo pipefail

PHP_VERSION="${PHP_VERSION:-8.3}"
NODE_VERSION="${NODE_VERSION:-24}"
NVM_VERSION="${NVM_VERSION:-v0.40.3}"
INSTALL_REDIS="${INSTALL_REDIS:-false}"
INSTALL_SQLITE="${INSTALL_SQLITE:-true}"
CONFIGURE_WSL_SYSTEMD="${CONFIGURE_WSL_SYSTEMD:-true}"
USER_NAME="$(id -un)"
USER_HOME="$HOME"
NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

info(){ printf '\\n\\033[1;32m[INFO]\\033[0m %s\\n' "$*"; }
warn(){ printf '\\n\\033[1;33m[WARN]\\033[0m %s\\n' "$*" >&2; }
die(){ printf '\\n\\033[1;31m[ERROR]\\033[0m %s\\n' "$*" >&2; exit 1; }
trap 'die "Setup gagal pada baris ${LINENO}. Periksa pesan error di atas."' ERR

[[ $EUID -ne 0 ]] || die "Jalankan sebagai user biasa, bukan root."
command -v sudo >/dev/null || die "sudo tidak ditemukan."
[[ -r /etc/os-release ]] || die "OS tidak dikenali."
. /etc/os-release
[[ "${ID:-}" == ubuntu ]] || die "Gunakan Ubuntu WSL."
[[ "${VERSION_ID:-}" == "22.04" || "${VERSION_ID:-}" == "24.04" ]] || warn "Ubuntu ${VERSION_ID:-unknown} belum diuji."

# Enable systemd and set current Linux user as default while preserving other
# WSL configuration entries. Windows-side `wsl --shutdown` is required after.
if [[ "$CONFIGURE_WSL_SYSTEMD" == true ]]; then
  info "Mengatur /etc/wsl.conf untuk systemd dan default user..."
  sudo touch /etc/wsl.conf
  sudo cp /etc/wsl.conf /etc/wsl.conf.backup
  sudo python3 - "$USER_NAME" <<'PY'
import re, sys
path = "/etc/wsl.conf"
user = sys.argv[1]
try:
    lines = open(path, encoding="utf-8").read().splitlines()
except FileNotFoundError:
    lines = []

def update_section(lines, section, key, value):
    header = f"[{section}]"
    out, in_section, found_section, found_key = [], False, False, False
    for line in lines:
        m = re.match(r"^\s*\[([^\]]+)\]\s*$", line)
        if m:
            if in_section and not found_key:
                out.append(f"{key}={value}")
                found_key = True
            in_section = m.group(1).strip().lower() == section
            found_section |= in_section
            out.append(line)
            continue
        if in_section and re.match(r"^\s*" + re.escape(key) + r"\s*=", line, re.I):
            if not found_key:
                out.append(f"{key}={value}")
                found_key = True
            continue
        out.append(line)
    if in_section and not found_key:
        out.append(f"{key}={value}")
        found_key = True
    if not found_section:
        if out and out[-1].strip():
            out.append("")
        out.extend([header, f"{key}={value}"])
    return out

lines = update_section(lines, "boot", "systemd", "true")
lines = update_section(lines, "user", "default", user)
with open(path, "w", encoding="utf-8") as f:
    f.write("\n".join(lines).rstrip() + "\n")
PY
fi

info "Update APT dan install kebutuhan dasar..."
sudo apt-get update
sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y \
  ca-certificates curl wget gnupg lsb-release software-properties-common \
  apt-transport-https unzip zip git build-essential pkg-config openssl \
  rsync dos2unix python3 acl cron supervisor net-tools dnsutils jq tree htop

# Ubuntu 22.04 needs Ondrej PPA for PHP 8.3; Ubuntu 24.04 has PHP 8.3 natively.
if [[ "$VERSION_ID" == "22.04" ]]; then
  info "Menambahkan PPA PHP..."
  sudo add-apt-repository -y ppa:ondrej/php
  sudo apt-get update
fi

info "Install PHP ${PHP_VERSION} dan ekstensi Laravel..."
PHP_PKGS=(
  "php${PHP_VERSION}" "php${PHP_VERSION}-cli" "php${PHP_VERSION}-fpm"
  "php${PHP_VERSION}-common" "php${PHP_VERSION}-curl"
  "php${PHP_VERSION}-mbstring" "php${PHP_VERSION}-xml"
  "php${PHP_VERSION}-zip" "php${PHP_VERSION}-bcmath"
  "php${PHP_VERSION}-intl" "php${PHP_VERSION}-mysql"
  "php${PHP_VERSION}-gd" "php${PHP_VERSION}-readline"
  "php${PHP_VERSION}-opcache"
)
[[ "$INSTALL_SQLITE" == true ]] && PHP_PKGS+=("php${PHP_VERSION}-sqlite3")
[[ "$INSTALL_REDIS" == true ]] && PHP_PKGS+=("php${PHP_VERSION}-redis")
sudo apt-get install -y "${PHP_PKGS[@]}"

info "Install Composer, Nginx, MariaDB..."
sudo apt-get install -y composer nginx mariadb-server mariadb-client
[[ "$INSTALL_REDIS" == true ]] && sudo apt-get install -y redis-server

# Sensible local PHP development limits.
for ini in "/etc/php/${PHP_VERSION}/cli/php.ini" "/etc/php/${PHP_VERSION}/fpm/php.ini"; do
  if [[ -f "$ini" ]]; then
    sudo sed -i \
      -e 's/^[; ]*memory_limit\\s*=.*/memory_limit = 512M/' \
      -e 's/^[; ]*upload_max_filesize\\s*=.*/upload_max_filesize = 64M/' \
      -e 's/^[; ]*post_max_size\\s*=.*/post_max_size = 64M/' \
      -e 's/^[; ]*max_execution_time\\s*=.*/max_execution_time = 120/' "$ini"
  fi
done

# Install NVM/Node for the current user, never root.
if [[ ! -s "$NVM_DIR/nvm.sh" ]]; then
  info "Install NVM ${NVM_VERSION}..."
  curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh" | bash
fi
export NVM_DIR
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  # shellcheck disable=SC1090
  . "$NVM_DIR/nvm.sh"
  nvm install "$NODE_VERSION"
  nvm alias default "$NODE_VERSION"
  nvm use default
fi
NVM_BLOCK='export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"'
touch "$USER_HOME/.bashrc"
if ! grep -q 'NVM_DIR=.*\\.nvm' "$USER_HOME/.bashrc"; then
  printf '\\n# NVM\\n%s\\n' "$NVM_BLOCK" >> "$USER_HOME/.bashrc"
fi

# Allow convenient group access to web files; takes effect on next login.
getent group www-data >/dev/null && sudo usermod -aG www-data "$USER_NAME"

# Detect whether systemd is active now. If not, start services with service
# command for this session; systemd will take over after wsl --shutdown.
SYSTEMD_ACTIVE=false
if command -v systemctl >/dev/null 2>&1 && [[ "$(ps -p 1 -o comm= 2>/dev/null | tr -d ' ')" == systemd ]]; then
  SYSTEMD_ACTIVE=true
fi

start_service(){
  local name="$1"
  if [[ "$SYSTEMD_ACTIVE" == true ]]; then
    sudo systemctl enable "$name"
    sudo systemctl restart "$name"
  else
    warn "systemd belum aktif; mencoba start ${name} untuk sesi ini."
    sudo service "$name" restart || true
  fi
}

info "Start PHP-FPM, Nginx, MariaDB..."
start_service "php${PHP_VERSION}-fpm"
start_service nginx
start_service mariadb
[[ "$INSTALL_REDIS" == true ]] && start_service redis-server

# Keep MariaDB local to this WSL instance; do not expose it to the LAN.
DB_CONF="/etc/mysql/mariadb.conf.d/50-server.cnf"
if [[ -f "$DB_CONF" ]] && grep -qE '^[[:space:]]*bind-address[[:space:]]*=' "$DB_CONF"; then
  sudo sed -i -E 's/^[[:space:]]*bind-address[[:space:]]*=.*/bind-address = 127.0.0.1/' "$DB_CONF"
  if [[ "$SYSTEMD_ACTIVE" == true ]]; then
    sudo systemctl restart mariadb
  else
    sudo service mariadb restart || true
  fi
fi

if [[ "$SYSTEMD_ACTIVE" == true ]]; then
  sudo systemctl is-active --quiet mariadb || die "MariaDB gagal aktif. Cek: sudo systemctl status mariadb"
else
  warn "systemd belum aktif. Setelah wsl --shutdown, cek MariaDB dengan systemctl."
fi

info "Verifikasi versi..."
php -v | head -n 2
composer --version
git --version
nginx -v 2>&1
mariadb --version
command -v node >/dev/null && node --version
command -v npm >/dev/null && npm --version

cat <<EOF

========================================================
 Laravel + WSL 2 development setup selesai
========================================================
WSL:
  /etc/wsl.conf sudah diatur:
    [boot]
    systemd=true
    [user]
    default=${USER_NAME}

PENTING: buka PowerShell Windows, jalankan:
  wsl --shutdown
Kemudian buka kembali Ubuntu.

Stack:
  PHP ${PHP_VERSION}, PHP-FPM, Composer, Nginx, MariaDB
  Node.js ${NODE_VERSION} (NVM), Git
  Redis: ${INSTALL_REDIS}
  SQLite PHP extension: ${INSTALL_SQLITE}

MariaDB:
  Login admin lokal:
    sudo mariadb

  Buat database/user aplikasi (ganti nama dan password):
    CREATE DATABASE app_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
    CREATE USER 'app_user'@'localhost' IDENTIFIED BY 'GANTI_PASSWORD_KUAT';
    GRANT ALL PRIVILEGES ON app_db.* TO 'app_user'@'localhost';
    FLUSH PRIVILEGES;
    EXIT;

  Contoh .env:
    DB_CONNECTION=mysql
    DB_HOST=127.0.0.1
    DB_PORT=3306
    DB_DATABASE=app_db
    DB_USERNAME=app_user
    DB_PASSWORD=GANTI_PASSWORD_KUAT

  Root MariaDB tetap memakai autentikasi socket Ubuntu.
  Script tidak mengubah password root dan tidak membuka MariaDB ke LAN.

Laravel:
  mkdir -p ~/projects
  cd ~/projects
  composer create-project laravel/laravel nama-project

Nginx:
  Document root harus mengarah ke folder public/.
  PHP-FPM socket: /run/php/php${PHP_VERSION}-fpm.sock

Setelah WSL restart, cek:
  systemctl status mariadb --no-pager
  systemctl status nginx --no-pager
  systemctl status php${PHP_VERSION}-fpm --no-pager
========================================================
EOF

info "Selesai. Jalankan 'wsl --shutdown' dari PowerShell, lalu buka Ubuntu kembali."
